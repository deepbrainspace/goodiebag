  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "alwaysAllow": ["resolve-library-id", "get-library-docs"]
    },
    "Bright Data": {
      "command": "npx",
      "args": ["@brightdata/mcp"],
      "env": {
        "API_TOKEN": "your-brightdata-api-token",
        "WEB_UNLOCKER_ZONE": "mcp_unlocker",
        "BROWSER_AUTH": "your-browser-auth-string"
      },
      "alwaysAllow": [
        "search_engine",
        "scrape_as_html",
        "web_data_amazon_product",
        "web_data_linkedin_company_profile"
      ],
      "disabled": false
    },
    "search-serper": {
      "command": "npx",
      "args": ["-y", "@deepbrainspace/serper-search-mcp@0.2.1"],
      "alwaysAllow": ["serper-google-search"],
      "env": {
        "SERPER_API_KEY": "your-serper-api-key",
        "SERPER_LLM_API_KEY": "your-google-api-key-optional"
      },
      "disabled": false
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "brave-search-mcp"],
      "env": {
        "BRAVE_API_KEY": "your-brave-api-key"
      },
      "alwaysAllow": ["brave_web_search"],
      "disabled": false
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "fc-your-firecrawl-api-key"
      },
      "alwaysAllow": [
        "firecrawl_scrape",
        "firecrawl_search",
        "firecrawl_deep_research"
      ]
    },
    "gmail": {
      "command": "npx",
      "args": ["@gongrzhe/server-gmail-autoauth-mcp"],
      "alwaysAllow": [
        "send_email",
        "draft_email",
        "read_email",
        "search_emails",
        "modify_email",
        "delete_email",
        "list_email_labels",
        "batch_modify_emails",
        "batch_delete_emails",
        "create_label",
        "update_label",
        "delete_label",
        "get_or_create_label"
      ],
      "disabled": false
    },
    "airtable": {
      "command": "npx",
      "args": ["-y", "airtable-mcp-server"],
      "env": {
        "AIRTABLE_API_KEY": "your-airtable-api-key"
      },
      "alwaysAllow": ["list_bases"],
      "disabled": true
    },
    "reddit": {
      "command": "uvx",
      "args": ["reddit-mcp"],
      "env": {
        "REDDIT_CLIENT_ID": "your-reddit-client-id",
        "REDDIT_CLIENT_SECRET": "your-reddit-client-secret"
      },
      "alwaysAllow": [
        "search_subreddits",
        "search_posts",
        "get_comment_by_id",
        "get_comments_by_submission",
        "get_subreddit",
        "get_submission"
      ],
      "disabled": false
    }
  }
}