# Source utility functions
. "$(dirname "$0")/utils.sh"

info "Validating commit message format..."

# Validate conventional commit format
commit_regex='^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert|wip)(\(.+\))?: .{1,50}'

if ! grep -qE "$commit_regex" "$1"; then
  error "Invalid commit message format!"
  echo ""
  pointer "Conventional commit format required:"
  echo "   <type>[optional scope]: <description>"
  echo ""
  pointer "Valid types:"
  echo "   feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
  echo ""
  pointer "Examples:"
  echo "   feat: add new user authentication"
  echo "   fix(api): resolve login timeout issue" 
  echo "   docs: update README with new examples"
  echo "   feat(nx-rust): add cargo build support"
  echo ""
  warning "Your commit message:"
  echo "   $(cat "$1")"
  exit 1
fi

success "Commit message format is valid"