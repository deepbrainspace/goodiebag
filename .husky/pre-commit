# Source utility functions
. "$(dirname "$0")/utils.sh"

# Block direct commits to main branch
info "Checking branch protection..."
debug_echo "Checking branch name..."
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
debug_echo "Current branch is: $CURRENT_BRANCH"
if [ "$CURRENT_BRANCH" = "main" ]; then
  error "Branch protection: Direct commits to main branch are not allowed"
  tip "Create a feature branch: git checkout -b feature/your-feature"
  exit 1
fi
success "Branch protection: Feature branch detected ($CURRENT_BRANCH)"
debug_echo "Branch check passed"

# Check for unstaged changes
info "Checking for unstaged changes..."
debug_echo "Checking for unstaged changes to tracked files..."
if ! git diff-files --quiet; then
  error "Unstaged changes: You have unstaged changes to tracked files!"
  fix "Please stage all changes before committing:"
  git diff --name-only
  echo ""
  tip "Run: git add . && git commit"
  exit 1
fi

debug_echo "Checking for untracked files..."
UNTRACKED_FILES=$(git ls-files --others --exclude-standard)
if [ -n "$UNTRACKED_FILES" ]; then
  error "Untracked files: You have untracked files!"
  fix "Please add or ignore these files before committing:"
  echo "$UNTRACKED_FILES"
  echo ""
  tip "Run: git add . && git commit"
  tip "Or add to .gitignore if they should be ignored"
  exit 1
fi
success "Working tree clean: No unstaged or untracked files"
debug_echo "Unstaged check passed"

# Check for actual secret values (long strings that look like tokens/keys)
debug_echo "Starting secret detection..."
STAGED_FILES=$(git diff --cached --name-only | grep -v "^\.husky/" | grep -v "pnpm-lock.yaml" || true)
debug_echo "Staged files for secret check: '$STAGED_FILES'"

# Filter out git-crypt encrypted files from secret detection
UNENCRYPTED_FILES=""
ENCRYPTED_FILES=""
if [ -n "$STAGED_FILES" ] && command -v git-crypt >/dev/null 2>&1; then
  for file in $STAGED_FILES; do
    # Check if file is encrypted by git-crypt
    if git-crypt status "$file" 2>/dev/null | grep -q "encrypted"; then
      ENCRYPTED_FILES="$ENCRYPTED_FILES $file"
      debug_echo "Skipping secret detection for encrypted file: $file"
    else
      UNENCRYPTED_FILES="$UNENCRYPTED_FILES $file"
    fi
  done
  
  # Show encrypted files being skipped (important user info)
  if [ -n "$ENCRYPTED_FILES" ]; then
    warning "Skipping secret detection for git-crypt encrypted files:$ENCRYPTED_FILES"
  fi
else
  UNENCRYPTED_FILES="$STAGED_FILES"
fi

if [ -n "$UNENCRYPTED_FILES" ]; then
  debug_echo "Running secret detection on unencrypted files: $UNENCRYPTED_FILES"
  # Look for patterns that look like actual secret values:
  # - Long base64-like strings (20+ chars)
  # - API key patterns (sk-, ghp_, etc.)
  # - JWT tokens (starting with ey)
  SECRET_MATCHES=$(echo "$UNENCRYPTED_FILES" | xargs grep -n -E "(sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{20,}|ey[a-zA-Z0-9]{20,}|['\"][a-zA-Z0-9+/]{32,}['\"])" 2>/dev/null || true)
  if [ -n "$SECRET_MATCHES" ]; then
    error "Secret detection: Potential secret values detected!"
    info "Found the following matches:"
    echo "$SECRET_MATCHES"
    echo ""
    tip "Please review and ensure no actual secrets are being committed"
    tip "Continue anyway? (y/N)"
    read -r response
    if [ "$response" != "y" ] && [ "$response" != "Y" ]; then
      stop "Commit aborted"
      exit 1
    fi
    warning "Secret detection: Proceeding with user override"
  else
    success "Secret detection: No secrets found"
  fi
else
  debug_echo "No unencrypted files to check for secrets (encrypted files excluded)"
  warning "Secret detection: Only encrypted files found, skipping scan"
fi
debug_echo "Secret detection completed"

# Check git-crypt status for staged files only
debug_echo "Starting git-crypt check..."
if command -v git-crypt >/dev/null 2>&1; then
  debug_echo "git-crypt found"
  # Check if git-crypt is initialized
  if git-crypt status >/dev/null 2>&1; then
    # Check only staged files that should be encrypted
    STAGED_FILES=$(git diff --cached --name-only)
    CRYPT_ISSUES=""
    
    if [ -n "$STAGED_FILES" ]; then
      for file in $STAGED_FILES; do
        # Check if file should be encrypted according to .gitattributes
        if git check-attr filter "$file" | grep -q "git-crypt"; then
          # Check if file is actually encrypted
          if ! git-crypt status "$file" 2>/dev/null | grep -q "encrypted"; then
            CRYPT_ISSUES="$CRYPT_ISSUES$file: should be encrypted but appears unencrypted\n"
          fi
        fi
      done
      
      if [ -n "$CRYPT_ISSUES" ]; then
        error "Git-crypt: Staged files have encryption issues!"
        echo -e "$CRYPT_ISSUES"
        tip "Run 'git-crypt status <file>' to check specific files"
        tip "Continue anyway? (y/N)"
        read -r response
        if [ "$response" != "y" ] && [ "$response" != "Y" ]; then
          stop "Commit aborted"
          exit 1
        fi
        warning "Git-crypt: Proceeding with encryption issues"
      else
        success "Git-crypt: All required files properly encrypted"
      fi
    else
      debug_echo "No staged files to check for encryption"
      success "Git-crypt: No files requiring encryption"
    fi
  else
    debug_echo "git-crypt not initialized"
    warning "Git-crypt: Not initialized, skipping encryption check"
  fi
else
  debug_echo "git-crypt not found"
  warning "Git-crypt: Not installed, skipping encryption check"
fi
debug_echo "git-crypt check completed"

# Format affected files with NX
debug_echo "Starting code formatting..."
debug_echo "Running NX format on uncommitted changes..."
nx format:write --uncommitted

# Check if any files were formatted
debug_echo "Checking if any files were modified during formatting..."
if ! git diff --quiet; then
  debug_echo "Files were modified during formatting process"
  error "Code formatting: Files were automatically formatted:"
  git diff --name-only
  echo ""
  tip "Please review the changes and re-run your commit"
  echo "   git add . && git commit"
  exit 1
else
  success "Code formatting: All files already properly formatted"
fi
debug_echo "Pre-commit hook completed successfully"
