# Source utility functions
. "$(dirname "$0")/utils.sh"

pointer "Running pre-push validation..."

# Check lockfile sync before pushing
info "Testing frozen lockfile check..."
pnpm install --frozen-lockfile --ignore-scripts
EXIT_CODE=$?
echo "Exit code: $EXIT_CODE"

if [ $EXIT_CODE -ne 0 ]; then
  error "Lockfile is out of sync!"
  echo ""
  pointer "Fix this issue:"
  echo "   pnpm install"
  echo "   git add pnpm-lock.yaml"
  echo "   git commit -m \"chore: update lockfile\""
  echo ""
  warning "Then try pushing again"
  exit 1
fi

success "Lockfile check passed"