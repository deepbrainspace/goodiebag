# Source utility functions
. "$(dirname "$0")/utils.sh"

# Check lockfile sync before pushing
info "Testing frozen lockfile check..."
pnpm install --frozen-lockfile --ignore-scripts
EXIT_CODE=$?
echo "Exit code: $EXIT_CODE"

if [ $EXIT_CODE -ne 0 ]; then
  error "Lockfile is out of sync!"
  fix "Please run 'pnpm install' to update lockfiles and commit the changes"
  tip "Then try pushing again"
  exit 1
fi

success "Lockfile check passed"